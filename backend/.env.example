# backend/.env.example — copy to backend/.env and fill in. Never commit .env.

# ── Server ──────────────────────────────────────
PORT=5000

# ── MongoDB ─────────────────────────────────────
# Note: @ in the password must be URL-encoded as %40
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/linguapaws

# ── JWT ─────────────────────────────────────────
JWT_SECRET=change_me
JWT_EXPIRES_IN=30d

# ── Google OAuth ────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ── OpenAI ──────────────────────────────────────
# Used for the LLM, for Whisper as the STT fallback, and for TTS when Google
# below is unset. OpenAI's tts-1-hd has no Telugu, Kannada or Odia voice.
OPENAI_API_KEY=sk-...

# ── Frontend origin (for CORS) ──────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Gemini (optional) ───────────────────────────
# Leave unset and generateWithFallback uses OpenAI everywhere.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Deepgram (speech to text) ───────────────────
DEEPGRAM_API_KEY=your_deepgram_key_here

# ── Google Cloud Text-to-Speech ─────────────────
# This is the only thing standing between the app and a real Telugu or Kannada
# voice. Unset, every non-English utterance is synthesised by OpenAI tts-1-hd,
# which is an English voice sounding out a script it does not know; the server
# says so once per process on startup of the first TTS request.
#
# Set ONE of the two. GOOGLE_TTS_CREDENTIALS_JSON is preferred because it needs
# no file on disk.
#
# GOOGLE_TTS_CREDENTIALS_JSON — the entire service-account key file, as one line
# of JSON. Wrap it in single quotes; it contains double quotes and \n escapes
# inside the private_key, and both must survive verbatim. Shape:
#   {"type":"service_account","project_id":"...","private_key_id":"...",
#    "private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
#    "client_email":"...@....iam.gserviceaccount.com","client_id":"...", ...}
# The service account needs the "Cloud Text-to-Speech API" enabled on its
# project. No IAM role beyond that is required for synthesis.
# GOOGLE_TTS_CREDENTIALS_JSON='{"type":"service_account", ... }'
#
# GOOGLE_APPLICATION_CREDENTIALS — absolute path to that same key file on disk,
# the standard Google client-library variable. Use this one if you would rather
# not have the key inside .env.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
